# Development instance configuration.
# Copy this file to .env.dev and use it only for the isolated dev stack.

COMPOSE_PROJECT_NAME=discord-bridge-dev
COMPOSE_ENV_FILE=.env.dev

DISCORD_TOKEN=
FEDIFY_SHARED_SECRET=
PUBLIC_BASE_URL=https://discord-bridge-dev.example.com
DATABASE_URL=sqlite:///./bridge-dev.db

BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_BIND_PORT=8181
GATEWAY_BIND_PORT=3100
BRIDGE_GATEWAY_URL=http://127.0.0.1:3100
BRIDGE_PUBLISHED_PORT=8181
GATEWAY_PUBLISHED_PORT=3100

DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
REGISTRATION_SESSION_COOKIE_NAME=bridge_dev_registration_session
REGISTRATION_SESSION_TTL_SECONDS=3600

FEDERATION_ALLOWLIST=
FEDERATION_BLOCKLIST=
DISCORD_GUILD_ALLOWLIST=
DISCORD_GUILD_BLOCKLIST=
BRIDGE_SUPER_ADMIN_USER_IDS=123456789012345678
FEDIFY_ACTOR_IDENTIFIER=bridge-dev
FEDIFY_ACTOR_NAME=Discord Fediverse Bridge Development Gateway
FEDIFY_ACTOR_SUMMARY=Development ActivityPub gateway for Discord Fediverse Bridge.
BRIDGE_DISPLAY_PREFIX=[bridge-dev]
LOG_LEVEL=INFO

BRIDGE_VERSION=dev
BRIDGE_IMAGE=discord-fediverse-bridge-dev
GATEWAY_IMAGE=discord-fediverse-bridge-gateway-dev
BRIDGE_DATA_VOLUME=discord-fediverse-bridge-dev-data
BACKUP_HOST_DIR=./backups-dev
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7

NGINX_HTTP_PORT=8188
NGINX_HTTPS_PORT=8543
NGINX_TLS_DIR=./deploy/nginx/tls-dev
NGINX_CONFIG=./deploy/nginx/default.conf.template
