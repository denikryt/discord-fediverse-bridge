# Required variables.

# Discord bot token.
DISCORD_TOKEN=

# Shared secret between Python bridge and fedify-gateway.
FEDIFY_SHARED_SECRET=

# Public base URL of the fedify-gateway (used to build local actor URLs).
FEDIFY_ORIGIN=https://discord-bridge.example.com

# Shared database URL for the Python bridge.
DATABASE_URL=sqlite:///./bridge.db

# Common variables.

# Local fedify-gateway base URL used by the Python bridge for follow/publish calls.
FEDIFY_GATEWAY_URL=http://127.0.0.1:3000

# Internal FastAPI bind address for Python-side HTTP intake and registration pages.
INTERNAL_HTTP_HOST=127.0.0.1
INTERNAL_HTTP_PORT=8081

# Public base URL advertised by the bridge for registration and local actor URLs.
PUBLIC_BRIDGE_BASE_URL=https://discord-bridge.example.com

# Optional variables.

# Discord OAuth settings for web registration.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://discord-bridge.example.com/auth/discord/callback

# Registration session settings for the web flow.
REGISTRATION_SESSION_COOKIE_NAME=bridge_registration_session
REGISTRATION_SESSION_TTL_SECONDS=3600

# Comma-separated list of allowed Lemmy instance hostnames (e.g. "lemmy.world,beehaw.org").
# Empty means all instances are allowed (open federation).
FEDERATION_ALLOWLIST=

# Message formatting and runtime logging.
BRIDGE_DISPLAY_PREFIX=[bridge]
LOG_LEVEL=INFO
