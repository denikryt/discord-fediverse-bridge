# Required application variables.

# Production Compose instance selection.
# Copy this file to .env; .env.dev.example is the isolated development template.
COMPOSE_PROJECT_NAME=discord-bridge-prod
COMPOSE_ENV_FILE=.env


# Discord bot token.
DISCORD_TOKEN=

# Shared secret between Python bridge and fedify-gateway.
FEDIFY_SHARED_SECRET=

# One public URL for federation, registration, dashboard links, and OAuth.
PUBLIC_BASE_URL=https://discord-bridge.example.com

# Shared database URL for local non-Docker runs.
DATABASE_URL=sqlite:///./bridge.db

# Local deployment defaults.
# These values work out of the box for plain local runs and can be overridden
# if you want different bind or published ports.
# BRIDGE_BIND_HOST/PORT are the Python bridge process bind address.
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_BIND_PORT=8081
# GATEWAY_BIND_PORT is the fedify-gateway process bind port.
GATEWAY_BIND_PORT=3000
# BRIDGE_GATEWAY_URL is the bridge-to-gateway URL used by direct runs.
BRIDGE_GATEWAY_URL=http://127.0.0.1:3000

# Docker-published host ports.
# These are only used when the stack runs under Docker Compose.
# BRIDGE_PUBLISHED_PORT is the host-facing port forwarded to the Python bridge.
BRIDGE_PUBLISHED_PORT=8081
# GATEWAY_PUBLISHED_PORT is the host-facing port forwarded to the gateway.
GATEWAY_PUBLISHED_PORT=3000

# The gateway derives its Python delivery URL from BRIDGE_BIND_HOST/PORT
# unless Docker Compose overrides it with the container-internal bridge address.

# Optional Discord OAuth settings for web registration.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Optional registration session settings for the web flow.
REGISTRATION_SESSION_COOKIE_NAME=bridge_registration_session
REGISTRATION_SESSION_TTL_SECONDS=3600

# Optional federation and management policy.
# Empty FEDERATION_ALLOWLIST means open federation.
FEDERATION_ALLOWLIST=
LOCAL_COMMUNITY_OPERATOR_ALLOWLIST=

# Optional gateway actor metadata.
FEDIFY_ACTOR_IDENTIFIER=bridge
FEDIFY_ACTOR_NAME=Discord Lemmy Bridge Gateway
FEDIFY_ACTOR_SUMMARY=Receives ActivityPub activities from Lemmy and forwards normalized events to the Python bridge.

# Message formatting and runtime logging.
BRIDGE_DISPLAY_PREFIX=[bridge]
LOG_LEVEL=INFO

# Docker Compose settings.
# Docker Compose reads this same root .env file for both interpolation and
# container environment. The service-specific runtime overrides remain in
# compose.yaml (container bind addresses, shared database path, and internal URLs).
BRIDGE_VERSION=0.1.0
BRIDGE_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/discord-fediverse-bridge
GATEWAY_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/discord-fediverse-bridge-gateway
BRIDGE_DATA_VOLUME=discord-fediverse-bridge-data
BACKUP_HOST_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=14

# Optional bundled nginx settings.
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
NGINX_TLS_DIR=./deploy/nginx/tls
NGINX_CONFIG=./deploy/nginx/default.conf.template
