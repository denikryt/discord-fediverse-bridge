# Required application variables.

# Discord bot token.
DISCORD_TOKEN=

# Shared secret between Python bridge and fedify-gateway.
FEDIFY_SHARED_SECRET=

# Public base URL of the fedify-gateway (used to build local actor URLs).
FEDIFY_ORIGIN=https://discord-bridge.example.com

# Shared database URL for local non-Docker runs.
DATABASE_URL=sqlite:///./bridge.db

# Persistent ActivityPub signing keys. Generate with:
#   cd fedify-gateway && npm run generate-keys
FEDIFY_BRIDGE_PRIVATE_KEY_JWK_JSON=
FEDIFY_BRIDGE_PUBLIC_KEY_JWK_JSON=

# Common application variables.

# Local fedify-gateway base URL used by the Python bridge for follow/publish calls.
FEDIFY_GATEWAY_URL=http://127.0.0.1:3000

# Internal FastAPI bind address for Python-side HTTP intake and registration pages.
INTERNAL_HTTP_HOST=127.0.0.1
INTERNAL_HTTP_PORT=8081

# Internal gateway bind port.
FEDIFY_PORT=3000

# Internal Python intake endpoint used by fedify-gateway.
PYTHON_BRIDGE_EVENTS_URL=http://127.0.0.1:8081/internal/activitypub/events

# Public base URL advertised by the bridge for registration and local actor URLs.
PUBLIC_BRIDGE_BASE_URL=https://discord-bridge.example.com

# Public hostname and local upstream targets used by fedify-gateway/nginx-setup.sh.
PUBLIC_DOMAIN=discord-bridge.example.com
GATEWAY_UPSTREAM=http://127.0.0.1:3000
PYTHON_BRIDGE_UPSTREAM=http://127.0.0.1:8081

# Optional Discord OAuth settings for web registration.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://discord-bridge.example.com/auth/discord/callback

# Optional registration session settings for the web flow.
REGISTRATION_SESSION_COOKIE_NAME=bridge_registration_session
REGISTRATION_SESSION_TTL_SECONDS=3600

# Optional federation and management policy.
# Empty FEDERATION_ALLOWLIST means open federation.
FEDERATION_ALLOWLIST=
LOCAL_COMMUNITY_OPERATOR_ALLOWLIST=

# Optional gateway actor metadata.
FEDIFY_ACTOR_IDENTIFIER=bridge
FEDIFY_ACTOR_NAME=Discord Lemmy Bridge Gateway
FEDIFY_ACTOR_SUMMARY=Receives ActivityPub activities from Lemmy and forwards normalized events to the Python bridge.

# Message formatting and runtime logging.
BRIDGE_DISPLAY_PREFIX=[bridge]
LOG_LEVEL=INFO

# Docker Compose settings.
# Docker Compose reads this same root .env file for both interpolation and
# container environment. The service-specific runtime overrides remain in
# compose.yaml (container bind addresses, shared database path, and internal URLs).
BRIDGE_VERSION=0.1.0
BRIDGE_IMAGE=discord-fediverse-bridge
GATEWAY_IMAGE=discord-fediverse-bridge-fedify-gateway
BRIDGE_HOST_PORT=8080
GATEWAY_HOST_PORT=3000
BRIDGE_DATA_VOLUME=discord-fediverse-bridge-data

# Optional bundled nginx settings.
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
NGINX_TLS_DIR=./deploy/nginx/tls
NGINX_CONFIG=./deploy/nginx/default.conf.template
