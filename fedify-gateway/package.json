{
  "name": "discord-lemmy-bridge-fedify-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env ./node_modules/.bin/tsx watch src/server.ts",
    "start": "node --env-file=../.env ./node_modules/.bin/tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "npm run check && for test in tests/verify-*.ts; do echo \"Running $test\"; ./node_modules/.bin/tsx \"$test\" || exit 1; done",
    "follow-community": "node --env-file=../.env ./node_modules/.bin/tsx src/follow-community-cli.ts",
    "unfollow-community": "node --env-file=../.env ./node_modules/.bin/tsx src/unfollow-community-cli.ts",
    "verify:local-community-canonical-key": "node --env-file=../.env ./node_modules/.bin/tsx tests/verify-local-community-canonical-key.ts",
    "test:project-version": "./node_modules/.bin/tsx tests/verify-project-version.ts",
    "test:docker-contract": "./node_modules/.bin/tsx src/test-docker-contract.ts",
    "test:bridge-key-store": "./node_modules/.bin/tsx tests/verify-bridge-actor-key-store.ts"
  },
  "dependencies": {
    "@fedify/fedify": "^2.2.0",
    "@fedify/hono": "^2.2.0",
    "@fedify/vocab": "^2.2.0",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
