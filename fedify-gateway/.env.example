FEDIFY_ORIGIN=https://bot.example.com
FEDIFY_PORT=3000
# Preferred nginx mode: one public hostname, with ActivityPub routed to
# fedify-gateway and registration/OAuth routed to the Python bridge.
DEPLOYMENT_MODE=single-domain
PUBLIC_DOMAIN=bot.example.com

# Legacy two-domain mode. Used only when DEPLOYMENT_MODE=two-domain.
GATEWAY_DOMAIN=bot.example.com
BRIDGE_DOMAIN=bridge.bot.example.com

FEDIFY_ACTOR_IDENTIFIER=bridge
FEDIFY_ACTOR_NAME=Discord Lemmy Bridge Gateway
FEDIFY_ACTOR_SUMMARY=Receives ActivityPub activities from Lemmy and forwards normalized events to the Python bridge.
# Shared DB file with the Python bridge.
DATABASE_URL=sqlite:///../bridge.db
PYTHON_BRIDGE_EVENTS_URL=http://127.0.0.1:8081/internal/activitypub/events
PYTHON_BRIDGE_SHARED_SECRET=change-me
# AP signing key pair for the bridge actor. Generate with: npm run generate-keys
FEDIFY_BRIDGE_PRIVATE_KEY_JWK_JSON=
FEDIFY_BRIDGE_PUBLIC_KEY_JWK_JSON=
# Logging level: "debug" enables verbose federation tracing, "info" for production.
LOG_LEVEL=info
