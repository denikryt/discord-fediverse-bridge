# Required variables.

# AP signing key pair for the bridge actor. Generate with: npm run generate-keys
FEDIFY_BRIDGE_PRIVATE_KEY_JWK_JSON=
FEDIFY_BRIDGE_PUBLIC_KEY_JWK_JSON=

# Common variables.

FEDIFY_PORT=3000
# Shared DB file with the Python bridge.
DATABASE_URL=sqlite:///../bridge.db

# Optional variables.

FEDIFY_ACTOR_IDENTIFIER=bridge
FEDIFY_ACTOR_NAME=Discord Lemmy Bridge Gateway
FEDIFY_ACTOR_SUMMARY=Receives ActivityPub activities from Lemmy and forwards normalized events to the Python bridge.
